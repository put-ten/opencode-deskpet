<Window x:Class="DeskPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="96" Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
  <Grid Name="MainGrid">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="模式: 自由漫游" Name="MenuMode" Click="OnMenuModeToggle"/>
        <Separator/>
        <MenuItem Header="透明度">
          <MenuItem.Icon>
            <TextBlock Text="▦  " FontSize="10"/>
          </MenuItem.Icon>
          <Slider Name="OpacitySlider" Minimum="20" Maximum="100" Value="100"
                  Width="120" ValueChanged="OnOpacityChanged"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="设置..." Name="MenuSettings" Click="OnMenuSettings"/>
        <MenuItem Header="退出" Name="MenuExit" Click="OnMenuExit"/>
      </ContextMenu>
    </Grid.ContextMenu>
    <Image Name="PetImage"
           Width="96" Height="96"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
            Margin="0,64,0,0"
            MouseEnter="OnPetMouseEnter"
            MouseLeave="OnPetMouseLeave" />
    <Canvas Name="ParticleCanvas"
            IsHitTestVisible="False"
            Width="96" Height="160"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
  </Grid>
</Window>
