<Window x:Class="DeskPet.Chat.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat with Pudding"
        Width="340" Height="450"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#FFF5F8">
  <Window.Resources>
    <SolidColorBrush x:Key="PinkAccent" Color="#FF9ABA"/>
    <SolidColorBrush x:Key="BgLight" Color="#FFF5F8"/>
    <SolidColorBrush x:Key="BubblePet" Color="#FFE0EB"/>
    <SolidColorBrush x:Key="BubbleUser" Color="#E8E8E8"/>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource PinkAccent}" CornerRadius="0,0,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
        <TextBlock Text="╱◠ᴥ◠╲" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
        <TextBlock Text="  Chat with Pudding" FontSize="13" Foreground="White" 
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Messages -->
    <ScrollViewer Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Padding="8,4" Background="{StaticResource BgLight}">
      <ItemsControl Name="ChatItems"/>
    </ScrollViewer>

    <!-- Input -->
    <Border Grid.Row="2" Background="White" BorderBrush="#F0D0DA" BorderThickness="0,1,0,0">
      <Grid Margin="8,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Name="InputBox" Grid.Column="0"
                 BorderThickness="1" BorderBrush="#E8D0DA"
                 Background="White" Padding="8,6" FontSize="13"
                 VerticalContentAlignment="Center"
                 AcceptsReturn="False"
                 KeyDown="OnInputKeyDown">
          <TextBox.Resources>
            <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
              <VisualBrush.Visual>
                <TextBlock Text="  say something..." Foreground="#C0A0B0" FontSize="13"/>
              </VisualBrush.Visual>
            </VisualBrush>
          </TextBox.Resources>
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="Background">
                <Setter.Value>
                  <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Center">
                    <VisualBrush.Visual>
                      <TextBlock Text="  say something..." Foreground="#C0A0B0" FontSize="13"/>
                    </VisualBrush.Visual>
                  </VisualBrush>
                </Setter.Value>
              </Setter>
            </Style>
          </TextBox.Style>
        </TextBox>
        <Button Grid.Column="1" Content="喵~" Padding="12,6" Margin="8,0,0,0"
                Click="OnSendClick" FontSize="13" FontWeight="Bold"
                Foreground="White" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Name="BtnBg" Background="{StaticResource PinkAccent}"
                      CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BtnBg" Property="Background" Value="#E880A0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BtnBg" Property="Background" Value="#D07090"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
